; Aphelion — engine configuration.
;
; Developed against Godot 4.7.x (latest stable at time of writing: 4.7.2).
; The version CI installs lives in .github/workflows/ci.yml (GODOT_VERSION).

config_version=5

[application]

config/name="Aphelion"
config/description="Design a spacecraft, program its flight computer, fly real orbital mechanics."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon.svg"
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Profile="*res://scripts/core/profile.gd"
MissionDB="*res://scripts/missions/mission_db.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=1
theme/default_font_subpixel_positioning=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; No msaa_2d here on purpose. The Compatibility renderer does not implement it,
; so setting it only logged "2D MSAA is not yet supported for GLES3" on every
; launch while changing nothing. The one thing that needs smooth edges is the
; orbital map, and it asks for antialiasing on each draw call, which does work.
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.078, 1)

[physics]

; The orbital simulation does NOT use the engine physics server; see
; docs/DETERMINISM.md. These values only affect engine-side UI nodes.
common/physics_ticks_per_second=60
common/enable_object_picking=false

[input_devices]

pointing/emulate_touch_from_mouse=false
